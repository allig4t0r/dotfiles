#!/usr/bin/env zsh

set -euo pipefail

# -------------------------------
# Global gitleaks pre-commit hook
# -------------------------------

# 1. Allow full bypass via environment variable
if [[ "${GITLEAKS_DISABLE:-}" == "1" ]]; then
  exit 0
fi

# 2. Allow per-repo opt-out via config
if git config --bool hooks.gitleaks.disable 2>/dev/null | grep -q true; then
  exit 0
fi

# 3. Skip if gitleaks not installed
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠ gitleaks not found — skipping secret scan"
  exit 0
fi

# 4. Run scan only on staged changes
echo "🔎 Running gitleaks..."

if ! gitleaks git --pre-commit --redact --staged --verbose; then
  echo
  echo "❌ Commit blocked: potential secrets detected."
  echo "If this is intentional:"
  echo "  - Fix the secret"
  echo "  - Or run: GITLEAKS_DISABLE=1 git commit"
  echo "  - Or disable in this repo:"
  echo "        git config hooks.gitleaks.disable true"
  echo "  - To enable it back:"
  echo "        git config --unset hooks.gitleaks.disable"
  exit 1
fi

exit 0
